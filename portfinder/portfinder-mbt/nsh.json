{
  "name": "portradar",
  "id": "com.itang.portradar",
  "icon": "assets/icon.png",
  "version": "1.0.0",
  "build": 1,
  "nsh": "^0.7.1",
  "dependencies": {
    "portradar-native": { "path": "ext/portradar-native" }
  },
  "appearance": "system",
  "theme": {
    "cssVars": {
      "light": {
        "primary": "#2563eb",
        "primary-foreground": "#ffffff",
        "ring": "#2563eb"
      },
      "dark": {
        "primary": "#3b82f6",
        "primary-foreground": "#ffffff",
        "ring": "#3b82f6"
      }
    }
  },
  "window": {
    "title": "端口雷达",
    "defaultSize": { "width": 1000, "height": 720 },
    "titleBar": { "style": "hidden", "height": 44 }
  },
  "capabilities": {
    "application": true,
    "process": {
      "execute": ["ss", "lsof", "ps", "kill"]
    },
    "clipboard": true,
    "statusBar": true
  }
}
