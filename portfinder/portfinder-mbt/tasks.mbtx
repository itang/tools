---
import { "moonbitlang/core/env" }
import { "moonbitlang/core/path" }
import { "moonbitlang/core/async" }
import { "moonbitlang/core/async/process" }
---

using @path {type Path};

/// 用 Path::join 拼路径，避免手写平台相关的反斜杠。相对段可直接写 `/` 分隔，
/// join 会按当前平台归一化（Windows 上变成 `\`）。
fn under(root~: String, rel~: String) -> String {
  Path(root).join(Path(rel)).to_string()
  //Path::join(Path(root), Path(rel)).to_string()
}

/// 检查退出码，非 0 则打印错误并以相同退出码终止。exit 是泛型函数，可直接作为表达式。
fn check_exit(result~: @process.ProcessResult, label~: String) -> Unit {
  let code = result.exit_code
  if code != 0 {
    println("[失败] \{label}（退出码 \{code}）")
    @env.exit(code)
  }
}

/// 执行一步命令：打印命令、继承标准输入输出，失败则以相同退出码终止脚本。
async fn step(label~: String, cmd~: String, args~: Array[String], cwd~: String?) -> Unit {
  println("==> \{label}")
  println("    \{cmd} \{args.join(" ")}")
  let result = match cwd {
    Some(dir) => @process.run(cmd, args, cwd=dir)
    None => @process.run(cmd, args)
  }
  check_exit(result~, label~)
}

/// 编译 MoonBit（App.tsx 引用 release 产物，必须用 --release）。label 供各命令标注步骤序号。
async fn build_moonbit(label~: String, root~: String) -> Unit {
  step(label~, cmd="moon", args=["build", "--release"], cwd=Some(root))
}

/// 制作安装包：编译 MoonBit → 跑测试 → 打 nsh 包 → 生成安装程序。
async fn publish(root~: String) -> Unit {
  println("开始制作安装包…")
  build_moonbit(label="[1/4] 编译 MoonBit (release)", root~)
  step(label="[2/4] 运行界面测试", cmd="nsh", args=["test", "App.test.tsx"], cwd=Some(root))
  step(
    label="[3/4] 打包 nsh 便携包",
    cmd="nsh",
    args=["package", "--target", "windows"],
    cwd=Some(root),
  )
  step(
    label="[4/4] 生成安装程序",
    cmd="powershell",
    args=["-ExecutionPolicy", "Bypass", "-File", under(root~, rel="installer/make-installer.ps1")],
    cwd=Some(root),
  )
  println("完成：安装包位于 \{under(root~, rel="dist")}")
}

/// 开发模式：先编译 MoonBit（App.tsx 引用 release 产物），再运行 nsh run，退出码透传。
async fn dev(root~: String) -> Unit {
  println("进入开发模式…")
  build_moonbit(label="[1/2] 编译 MoonBit (release)", root~)
  println("[2/2] 启动 nsh run（按 Ctrl+C 退出）")
  let result = @process.run("nsh", ["run"], cwd=root)
  println("nsh run 已退出（退出码 \{result.exit_code}）")
  check_exit(result~, label="nsh run")
}

fn usage() -> Unit {
  let text = #|PortRadar 任务脚本
    #|用法：
    #|  moon run tasks.mbtx publish       制作安装包
    #|  moon run tasks.mbtx dev           编译 MoonBit 并开发模式下运行
    #|  moon run tasks.mbtx build:moonbit 仅编译 MoonBit (release)
  println(text)
}

async fn main {
  let args = @env.args()
  if args.length() < 2 {
    usage()
    @env.exit(1)
  }
  let root = match @env.current_dir() {
    Some(dir) => dir
    None => {
      println("无法获取当前工作目录，请在项目根目录运行")
      @env.exit(1)
    }
  }
  match args[1] {
    "publish" => publish(root~)
    "dev" => dev(root~)
    "build:moonbit" => build_moonbit(label="编译 MoonBit (release)", root~)
    "--help" | "-h" => usage()
    cmd => {
      println("未知命令：\{cmd}")
      usage()
      @env.exit(1)
    }
  }
}
