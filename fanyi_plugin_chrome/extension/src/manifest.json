{
  "manifest_version": 3,
  "name": "opencode 网页翻译",
  "version": "0.1.0",
  "description": "使用本地 opencode 命令将网页或选定区域一键翻译为中文，中英对照阅读。",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "scripting", "contextMenus", "activeTab"],
  "host_permissions": ["*://x.com/*", "*://twitter.com/*", "https://dict-trans.youdao.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "翻译网页 / 撤销翻译（Alt+Shift+T）" },
  "options_page": "options.html",
  "commands": {
    "toggle-translate": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "翻译或撤销当前页面"
    },
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "翻译选中的文本（无选中时翻译右键所在区域）"
    }
  }
}
